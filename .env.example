# Copy to .env (deployment) or .env.dev (devcontainer). Never commit the real files.
# Only secrets and per-deployment values live here; other tunables and their defaults are in src/ankibot/config.py.
TG_TOKEN=
TG_ALLOWED_USER_ID=
ANKI_USER=
ANKI_PASSWORD=
# Required: URL of your self-hosted Anki sync server.
# For the devcontainer local-sync profile use http://anki-sync:8080/
ANKI_SYNC_ENDPOINT=
ANKI_DECK=Japanese::Bot
DEEPL_API_KEY=
# Set at most one of DEEPL_API_KEY and GEMINI_API_KEY.
GEMINI_API_KEY=
# DeepL target_lang code (e.g. EN-US, ZH-HANT, KO); English targets keep the JMdict glosses as is.
TRANSLATION_TARGET=EN-US
# Language name for the Gemini prompt (e.g. Korean); empty uses a built-in name or the code.
TRANSLATION_TARGET_NAME=
# Bot UI language: a file name in src/ankibot/locales/ (en, zh-Hant).
BOT_LANGUAGE=en
# Audio: none (default) or edge (edge-tts, an unofficial Microsoft Edge endpoint).
TTS_PROVIDER=none
# Also speak one sentence per card (needs the SentenceAudio field in the note type).
TTS_SENTENCE=false
# Time zone for the "today" count in /stats (e.g. Asia/Taipei); the image default is UTC.
TZ=UTC

# Credentials for the local anki-sync server (devcontainer local-sync profile only), format user:password
SYNC_USER1=user:pass
